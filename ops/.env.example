# ---------------------------------------------------------------------------
# Application configuration
#
# Variable names mirror the live service exactly. Values here are placeholders —
# never commit real secrets. On Railway, ${{Service.VAR}} is a reference
# variable resolved at deploy time.
# ---------------------------------------------------------------------------

# --- URLs ------------------------------------------------------------------
# All three must be the PUBLIC address. These feed the OAuth callback URLs
# registered with every social platform, so changing them later means
# re-registering every app. Get this right before you buy a domain.
MAIN_URL="https://app.example.com"
FRONTEND_URL="https://app.example.com"
NEXT_PUBLIC_BACKEND_URL="https://app.example.com/api"

# Internal backend address. Stays on the private network, not public.
BACKEND_INTERNAL_URL="http://localhost:3000"

PORT="5000"

# --- Secrets ---------------------------------------------------------------
# Long random string. Rotating it invalidates every existing session.
#   openssl rand -base64 48
JWT_SECRET="generate-with-openssl-rand-base64-48"

# --- Datastores ------------------------------------------------------------
# On Railway these are reference variables:
#   DATABASE_URL="${{Postgres.DATABASE_URL}}"
#   REDIS_URL="${{Redis.REDIS_URL}}"
DATABASE_URL="postgresql://user:password@host:5432/app"
REDIS_URL="redis://default:password@host:6379"

# --- Storage ---------------------------------------------------------------
# "local" writes to the mounted volume. Switch to an S3-compatible provider
# before scaling: a single volume with no snapshot API is a hard ceiling on
# customer uploads, and it has no backup story.
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"

# --- Behaviour -------------------------------------------------------------
# Page titles, which sign-in providers appear, default landing route, some
# labels. Despite the name this is NOT the cloud/billing switch.
IS_GENERAL="true"

# "true" closes public signup. KEEP IT TRUE in production: accounts are created
# by the provisioning service after payment clears. Registration through the
# GENERIC OAuth provider bypasses this flag by design, which is exactly the
# mechanism provisioning uses.
DISABLE_REGISTRATION="true"

# Only "true" if you terminate TLS yourself. Railway terminates for you.
NOT_SECURED="false"

# --- Single sign-on: how customers actually get in -------------------------
# Your portal is the identity provider. After checkout, provisioning creates
# the identity; the customer clicks through and the app creates their
# organisation on first login. See packages/provisioning/src/provision/shared-sso.ts
POSTIZ_GENERIC_OAUTH="true"
POSTIZ_OAUTH_URL="https://auth.example.com"
POSTIZ_OAUTH_AUTH_URL="https://auth.example.com/oauth/authorize"
POSTIZ_OAUTH_TOKEN_URL="https://auth.example.com/oauth/token"
POSTIZ_OAUTH_USERINFO_URL="https://auth.example.com/oauth/userinfo"
POSTIZ_OAUTH_CLIENT_ID=""
POSTIZ_OAUTH_CLIENT_SECRET=""
# The label on the sign-in button. Your brand name.
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Kolo"

# --- Billing: deliberately absent ------------------------------------------
# DO NOT SET STRIPE_PUBLISHABLE_KEY.
#
# Its presence switches on the application's own billing UI, plan ladder and
# channel-cap enforcement, which would collide with the billing that runs
# beside the app. Billing is handled by the provisioning service through the
# payment processor.
#
# The consequence you must handle: with it unset, the application enforces NO
# plan limits — every organisation behaves as unlimited. Enforcing caps is
# therefore our job. See packages/provisioning/src/limits.ts.
#
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_SIGNING_KEY=""

# --- Telemetry: deliberately absent ----------------------------------------
# Upstream ships hooks for PostHog, Sentry, Datafast, a Meta pixel, Google Tag
# Manager, Dub and Plausible. All are inert unless their variable is set.
# Leave them unset so no customer data leaves this deployment. If you enable
# any, you must list it as a sub-processor in your privacy policy.
#
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_SENTRY_DSN=""
# DATAFAST_WEBSITE_ID=""
# FACEBOOK_PIXEL_ID=""
# GTM_ID=""

# --- Social platform credentials -------------------------------------------
# One pair per network you support. On shared plans these are YOUR app
# registrations and every customer posts through them; on dedicated instances
# they are the customer's own. See docs/03-oauth-app-registration.md — this is
# the long pole for launch, not the software.
#
# X_API_KEY=""
# X_API_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# ...and so on per platform.
